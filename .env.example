# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Secreta: solo en el servidor (Vercel → Environment Variables). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública de la web (para los links de los mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave para que tu software de ventas use la API /api/pos/*
# Generá una larga y al azar, por ejemplo con: openssl rand -hex 32
POS_API_KEY=cambiame-por-una-clave-larga
